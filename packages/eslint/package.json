{
  "name": "@homestuck/eslint-config",
  "version": "1.8.1",
  "private": false,
  "description": "Baseline ESLint configs used and maintained by Homestuck Inc., et al.",
  "repository": {
    "type": "git",
    "url": "https://github.com/homestuck/configs.git",
    "directory": "packages/eslint"
  },
  "license": "MIT",
  "author": "Homestuck <support@homestuck.com> (https://homestuck.com)",
  "type": "module",
  "exports": {
    ".": "./eslint.config.mjs",
    "./next": "./next.mjs",
    "./react": "./react.mjs"
  },
  "main": "./eslint.config.mjs",
  "scripts": {
    "clean": "rm -rf .turbo node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ./.prettierignore",
    "inspect:eslint": "eslint --inspect-config --config ./eslint.config.mjs",
    "inspect:next": "eslint --inspect-config --config ./next.mjs",
    "inspect:react": "eslint --inspect-config --config ./react.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "prettier": "@homestuck/prettier-config",
  "dependencies": {
    "@eslint/eslintrc": "catalog:eslint",
    "@eslint/js": "catalog:eslint",
    "@next/eslint-plugin-next": "catalog:eslint",
    "@typescript-eslint/eslint-plugin": "catalog:eslint",
    "@typescript-eslint/parser": "catalog:eslint",
    "eslint": "catalog:eslint",
    "eslint-config-prettier": "catalog:eslint",
    "eslint-import-resolver-alias": "catalog:eslint",
    "eslint-import-resolver-typescript": "catalog:eslint",
    "eslint-plugin-import": "catalog:eslint",
    "eslint-plugin-jsx-a11y": "catalog:eslint",
    "eslint-plugin-perfectionist": "catalog:eslint",
    "eslint-plugin-prettier": "catalog:eslint",
    "eslint-plugin-react": "catalog:eslint",
    "eslint-plugin-react-hooks": "catalog:eslint",
    "eslint-plugin-react-you-might-not-need-an-effect": "catalog:eslint",
    "eslint-plugin-regexp": "catalog:eslint",
    "eslint-plugin-simple-import-sort": "catalog:eslint",
    "eslint-plugin-storybook": "catalog:eslint",
    "eslint-plugin-turbo": "catalog:eslint",
    "eslint-plugin-unicorn": "catalog:eslint",
    "eslint-plugin-unused-imports": "catalog:eslint",
    "globals": "catalog:",
    "typescript-eslint": "catalog:eslint"
  },
  "devDependencies": {
    "@types/eslint": "catalog:eslint",
    "@types/node": "catalog:",
    "prettier": "catalog:prettier"
  }
}
